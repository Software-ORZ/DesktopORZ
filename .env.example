# Copie este arquivo para `.env` (na raiz do projeto) e preencha os valores.
# O `.env` está no .gitignore: nunca versione a chave real.
# Lido por `translate_ui_langs.py` em `langs/ui_langs/`.

# Chave de API da Respan (https://platform.respan.ai). Obrigatória em --translate.
RESPAN_API_KEY=

# Modelo usado no gateway hospedado da Respan (opcional).
RESPAN_MODEL=gpt-4o-mini